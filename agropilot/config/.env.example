# AgroPilot Environment Configuration Template
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to GitHub — it contains secrets!

# Set to true to force safe, local demo output even when a key is configured.
AGROPILOT_DEMO_MODE=true

# ────────────────────────────────────────────────────────────────
# Google Gemini API (LLM Engine)
# Get from: https://aistudio.google.com/app/apikeys
# ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ────────────────────────────────────────────────────────────────
# Tavily Search API (Equipment & Compliance Lookup)
# Get from: https://app.tavily.com/home
# ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ────────────────────────────────────────────────────────────────
# Google Gmail API (Quote Delivery)
# Setup: Generate token with python generate_gmail_token.py
# Get credentials from: https://console.cloud.google.com/auth/clients
# ────────────────────────────────────────────────────────────────
GMAIL_TOKEN_PATH=config/token_gmail.json
CREDENTIAL_GMAIL_PATH=config/credential_gmail.json

# ────────────────────────────────────────────────────────────────
# DocuSign API (E-Signature)
# Get from: https://apps-d.docusign.com/admin/authenticate?goTo=appsAndKeys
# ────────────────────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_USER_ID=your_user_id
DOCUSIGN_API_ACCOUNT_ID=your_account_id
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_PRIVATE_KEY_PATH=docusign_private.pem
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# ────────────────────────────────────────────────────────────────
# Slack API (Sales Team Notifications)
# Get from: https://app.slack.com/app-settings/YOUR_WORKSPACE_ID/YOUR_APP_ID/oauth
# ────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0B7JRYLKU5

# ────────────────────────────────────────────────────────────────
# Salesforce API (CRM Integration)
# OAuth2 JWT Bearer Flow (SOAP login is disabled in this org)
# Get from: https://your-instance.salesforce-setup.com/lightning/setup/ManageExternalClientApplication
# ────────────────────────────────────────────────────────────────
SALESFORCE_CLIENT_ID=your_client_id
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_PRIVATE_KEY_PATH=server_rsa.pem

# ────────────────────────────────────────────────────────────────
# Optional: Agent Configuration
# ────────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=11
LOG_LEVEL=INFO
